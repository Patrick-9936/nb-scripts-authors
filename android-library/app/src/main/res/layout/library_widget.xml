<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/widget_name"
            android:src="@drawable/nav_library"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_name"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_action"
            android:contentDescription="@string/widget_refresh"
            android:padding="10dp"
            android:src="@drawable/nav_refresh"
            android:tint="@color/widget_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:text="@string/widget_updated"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_search"
                style="@style/LibraryWidgetAction"
                android:layout_marginEnd="4dp"
                android:text="@string/widget_search" />
            <TextView
                android:id="@+id/widget_mine"
                style="@style/LibraryWidgetAction"
                android:layout_marginStart="4dp"
                android:text="@string/widget_mine" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_favorites"
                style="@style/LibraryWidgetAction"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                android:text="@string/widget_favorites" />
            <TextView
                android:id="@+id/widget_import"
                style="@style/LibraryWidgetAction"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:text="@string/widget_import" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
