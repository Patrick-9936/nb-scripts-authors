{
  "name": "script-library-cli",
  "version": "1.0.0",
  "description": "Каталог скриптов Null’s Brawl из терминала: поиск, код, избранное и запуск боя. Windows, Linux и macOS.",
  "keywords": [
    "nulls",
    "brawl",
    "scripts",
    "cli",
    "luau",
    "lua",
    "nulls-brawl"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "script-library": "bin/script-library.mjs",
    "sl": "bin/script-library.mjs"
  },
  "main": "src/cli.mjs",
  "exports": {
    ".": "./src/cli.mjs",
    "./battle": "./src/battle.mjs",
    "./params": "./src/params.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node bin/script-library.mjs",
    "doctor": "node bin/script-library.mjs doctor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Patrick-9936/nb-scripts-authors.git"
  },
  "dependencies": {}
}
